# ─────────────────────────────────────────────────────────────────────────────
# Weave — production .env for docker compose (copy to .env, then fill in).
# Used two ways: injected into the backend container (env_file), and read by
# compose for ${...} substitution (NEXT_PUBLIC_API_URL build arg, TUNNEL_TOKEN).
#
# <APP_HOST> = the public hostname serving the frontend (e.g. weave.example.com)
# <API_HOST> = the public hostname serving the backend  (e.g. api.weave.example.com)
# Both must be subdomains of the SAME domain so the auth cookie flows.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend → backend base URL (baked into the client bundle at build time) ──
NEXT_PUBLIC_API_URL=https://<API_HOST>

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → create tunnel → copy the token.
# Add two public hostnames on the tunnel:
#   <APP_HOST> -> http://frontend:3000
#   <API_HOST> -> http://backend:8000
TUNNEL_TOKEN=

# ── LLM provider ──────────────────────────────────────────────────────────────
# anthropic | gemini | ollama
LLM_PROVIDER=gemini
# Anthropic
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
# Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Auth: Google OAuth + JWT session ──────────────────────────────────────────
# Google Cloud Console → Credentials → OAuth client (Web application):
#   Authorized redirect URI:  https://<API_HOST>/auth/google/callback
#   Authorized JS origin:     https://<APP_HOST>
# If the consent screen is in "Testing", add each tester's email as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strong random secrets — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_SECRET=

# Comma-separated admin emails (unlimited, full access).
ADMIN_EMAILS=
# Per-user daily LLM-call limit for non-admins.
DAILY_REQUEST_LIMIT=20

# ── URLs / cookies ────────────────────────────────────────────────────────────
FRONTEND_URL=https://<APP_HOST>
ALLOWED_ORIGINS=https://<APP_HOST>
# HTTPS in production → mark cookies Secure (required for the tunnel).
COOKIE_SECURE=1

# ── Database (Postgres) ───────────────────────────────────────────────────────
# One source of truth for the DB credentials: these drive BOTH the `db`
# container and the backend's DATABASE_URL (assembled in docker-compose.yml,
# host = the `db` service). Change a password here and both stay in sync.
POSTGRES_USER=weave
POSTGRES_PASSWORD=change-me
POSTGRES_DB=weave

# Set DATABASE_URL explicitly ONLY to point at an external database (it then
# overrides the value built from POSTGRES_* above).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
