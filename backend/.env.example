# ── LLM provider ────────────────────────────────────────────────────────────
# Which provider to use: anthropic (default) | gemini | ollama
LLM_PROVIDER=anthropic

# Anthropic (default provider). Read automatically by the Anthropic SDK.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5

# Gemini (only if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Ollama (only if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=

# ── Auth: Google OAuth + JWT session ────────────────────────────────────────
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
#   APIs & Services → Credentials → Create Credentials → OAuth client ID
# Authorized redirect URI (must match exactly):
#   http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secrets for signing our own JWT session cookie and the OAuth state session.
# Generate strong random values, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_SECRET=

# ── URLs / cookies ──────────────────────────────────────────────────────────
# Where to send the browser back to after login; also the allowed CORS origin.
FRONTEND_URL=http://localhost:3000
# Comma-separated extra origins allowed by CORS (defaults to FRONTEND_URL).
# ALLOWED_ORIGINS=http://localhost:3000

# Set to 1 in production (HTTPS) so cookies are marked Secure.
# COOKIE_SECURE=0

# ── Database (Postgres) ─────────────────────────────────────────────────────
# Local dev uses the docker-compose Postgres (see repo-root docker-compose.yml):
#   docker compose up -d db
DATABASE_URL=postgresql+asyncpg://weave:weave@localhost:5432/weave
